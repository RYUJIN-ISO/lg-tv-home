#!/bin/sh
# Stops LG tracking/profiling/unused services after boot (see debloat.sh).
# Homebrew Channel runs init.d scripts one after another and keeps its
# failsafe flag armed until they all return, so the slow part (a 45 s wait and
# 2-3 min of systemctl calls) runs in the background and this returns at once.
setsid sh -c 'sleep 45; sh /var/lib/webosbrew/debloat.sh apply' > /tmp/debloat.log 2>&1 < /dev/null &
