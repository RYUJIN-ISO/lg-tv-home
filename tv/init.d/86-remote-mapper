#!/bin/sh
# Puts the remote mapper's key filter back into surface-manager's chain after
# boot (configd runtime values don't survive a reboot). Waits for configd /
# surface-manager, retries a few times. Skipped if remote-mapper/disabled exists.
D=/var/lib/webosbrew/remote-mapper
[ -f "$D/remap.js" ] || exit 0
sleep 20
for i in 1 2 3 4 5; do
    sh "$D/remote-mapper.sh" apply > /tmp/remote-mapper.log 2>&1 && exit 0
    sleep 10
done
