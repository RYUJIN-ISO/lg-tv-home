#!/bin/sh
# Puts the remote mapper's key filter back into surface-manager's chain after
# boot (configd runtime values don't survive a reboot). Waits for configd and
# retries, all in the background so Homebrew's startup isn't held up.
# Skipped if remote-mapper/disabled exists (checked by remote-mapper.sh).
D=/var/lib/webosbrew/remote-mapper
[ -f "$D/remap.js" ] || exit 0
setsid sh -c 'sleep 20; for i in 1 2 3 4 5; do sh '"$D"'/remote-mapper.sh apply && exit 0; sleep 10; done' \
    > /tmp/remote-mapper.log 2>&1 < /dev/null &
